#include <windows.h>

// Inert sleeping process with the supported P4V product version, for launch preflight tests.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2026,2,0,0
 PRODUCTVERSION 2026,2,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Inert P4V launch test fixture\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
